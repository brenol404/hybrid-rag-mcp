# Ollama (embedding + geração local)
OLLAMA_HOST=http://localhost:11434
EMBED_MODEL=bge-m3
LLM_MODEL=qwen3:8b

# Re-ranking opcional (cross-encoder). Requer Ollama >= 0.36 e o modelo:
#   ollama pull bge-reranker-v2-m3
# Deixe vazio para desativar o re-ranking (o pipeline funciona sem ele).
RERANK_MODEL=bge-reranker-v2-m3
RERANK_BUDGET=20

# Loop do agente: quantas iterações de busca+geração no máx por pergunta.
ASK_MAX_ITERATIONS=2

# Opcional: fallback para provedor de nuvem quando disponível.
# Deixe vazio se quiser apenas execução 100% local.
# CLOUD_BASE_URL=https://api.anthropic.com/v1
# CLOUD_API_KEY=
# CLOUD_MODEL=

# Diretórios
CORPUS_DIR=examples/corpus
DATA_DIR=data
AUDIT_LOG=data/audit.jsonl