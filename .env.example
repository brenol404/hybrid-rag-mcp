# Ollama (embedding + geração local)
OLLAMA_HOST=http://localhost:11434
EMBED_MODEL=bge-m3
LLM_MODEL=qwen3:8b

# Re-ranking opcional (cross-encoder). Requer Ollama >= 0.36 e o modelo:
#   ollama pull bge-reranker-v2-m3
# Deixe vazio para desativar o re-ranking (o pipeline funciona sem ele).
RERANK_MODEL=bge-reranker-v2-m3
RERANK_BUDGET=20

# Busca híbrida (RRF): top_k do BM25 e pesos da fusão.
# Defaults já otimizados via tools/grid_search.py (recall@1 0.83 -> 0.917 no corpus real).
# TOP_K=5
# BM25_TOP_K=10
# RRF_K=60
# RRF_W_VECTOR=1.0
# RRF_W_LEXICAL=1.5

# Loop do agente: quantas iterações de busca+geração no máx por pergunta.
ASK_MAX_ITERATIONS=2

# Opcional: fallback para provedor de nuvem quando disponível.
# Deixe vazio se quiser apenas execução 100% local.
# CLOUD_BASE_URL=https://api.anthropic.com/v1
# CLOUD_API_KEY=
# CLOUD_MODEL=

# Auth do transporte HTTP (opcional, recomendado ao expor na rede).
# Gere com: openssl rand -hex 32. Vazio = sem auth (só use em localhost).
# MCP_AUTH_TOKEN=

# Otimização de contexto (cache semântico + compressão estilo-Caveman)
# CACHE_ENABLED=true
# CACHE_PATH=data/cache.jsonl
# CACHE_SIM_THRESHOLD=0.92
# CACHE_TTL_SEC=3600
# CACHE_MAX_ENTRIES=256
# CONTEXT_COMPRESSION=0   # 0=off, 1=leve (conectivos/enchimentos), 2=agressivo (+ determinantes/auxiliares)

# Diretórios
CORPUS_DIR=examples/corpus
DATA_DIR=data
AUDIT_LOG=data/audit.jsonl
# Higiene do audit log: rotaciona ao passar de 5MB, mantendo 3 backups.
# AUDIT_MAX_BYTES=5000000
# AUDIT_KEEP=3

# Qdrant em modo servidor (opcional, multi-processo).
# Deixe vazio para o modo embarcado (default, sem Docker, 1 processo por vez).
# Com o servidor de pé (`docker compose up -d`), aponte para ele:
# QDRANT_URL=http://localhost:6333
# QDRANT_PATH=data/qdrant